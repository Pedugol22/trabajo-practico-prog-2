# Copiá este archivo como ".env" y completá tus valores.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

# Claves que acepta nuestra API (separadas por coma). Inventá las tuyas:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=pone-aca-una-clave-larga-y-secreta

# Clave que usa el cliente para llamar a nuestra API (una de las de arriba)
PROVEEDORES_API_KEY=pone-aca-la-misma-clave

# Dónde corre nuestra API (por defecto, local)
PROVEEDORES_API_URL=http://127.0.0.1:8000

# Poner en false para desactivar el scraping sin tocar el código
SCRAPING_HABILITADO=true

# Opcional: CUIT de proveedores críticos, separados por coma y sin guiones (criterio más estricto)
PROVEEDORES_CRITICOS=

# Opcional: correos del comité (etapa de email, más adelante)
COMITE_EMAILS=

# Opcional: ruta a un certificado CA si el BCRA da error de SSL en tu red
# BCRA_CA_BUNDLE=C:\ruta\al\certificado.pem
